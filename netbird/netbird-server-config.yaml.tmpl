# Combined NetBird Server Configuration (Simplified)
# Generated by getting-started.sh

# Usage: (from the .../OMV-DockerCompose/netbird/ folder)
# export $(grep -v '^#' ../global.env | xargs) && envsubst < netbird-server-config.yaml.tmpl > ../../OMV-DockerData-NVME/netbird/netbird-server-config.yaml

server:
  listenAddress: ":80"
  exposedAddress: "https://${DUCKDNS_FQDN}:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "${NSC_AUTHSECRET}"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://${DUCKDNS_FQDN}/oauth2"
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://${DUCKDNS_FQDN}/nb-auth"
      - "https://${DUCKDNS_FQDN}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.10/32"

  store:
    engine: "sqlite"
    encryptionKey: "${NSC_SQLITE_ENCRYPTOINKEY}"
