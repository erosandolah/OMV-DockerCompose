# Usage: (from the .../OMV-DockerCompose/netbird/ folder)
# export $(grep -v '^#' ../global.env | xargs) && envsubst < netbird-server-config.yaml.tmpl > netbird-server-config.yaml
# chmod 600 netbird-server-config.yaml

server:
  listenAddress: ":80"
  exposedAddress: "https://${MY_FQDN}:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "${NSC_AUTHSECRET}"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://${MY_FQDN}/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "${NSC_COOKIE_ENCRYPTIONKEY}"
    dashboardRedirectURIs:
      - "https://${MY_FQDN}/nb-auth"
      - "https://${MY_FQDN}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.10/32"
    trustedPeers:
      - "172.30.0.10/32"

  store:
    engine: "sqlite"
    encryptionKey: "${NSC_SQLITE_ENCRYPTIONKEY}"

